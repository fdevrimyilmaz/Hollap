{
  "name": "nextjs-shadcn",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d postgres",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:migrate:optional": "node scripts/db-migrate.mjs --optional-local",
    "db:seed": "node scripts/db-seed.mjs",
    "env:check": "node scripts/check-env.mjs",
    "env:check:deploy": "node scripts/check-env.mjs --no-file",
    "env:secrets": "node scripts/generate-secrets.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:ci": "node scripts/test-ci-precheck.mjs && vitest run",
    "ci": "npm run lint && npm run typecheck && npm run db:migrate:optional && npm run test:ci",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:tag": "node scripts/release-tag.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.988.0",
    "@aws-sdk/s3-request-presigner": "^3.988.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hls.js": "^1.6.16",
    "jose": "^6.1.3",
    "lucide-react": "^0.475.0",
    "next": "15.3.7",
    "nodemailer": "^8.0.1",
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.1",
    "same-runtime": "^0.0.1",
    "sonner": "^2.0.7",
    "stripe": "^20.3.1",
    "tailwind-merge": "^3.3.0",
    "tailwindcss-animate": "^1.0.7",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^20.17.50",
    "@types/nodemailer": "^7.0.9",
    "@types/pg": "^8.15.6",
    "@types/react": "^18.3.22",
    "@types/react-dom": "^18.3.7",
    "@types/web-push": "^3.6.4",
    "@vitest/ui": "^4.0.18",
    "eslint": "^9.27.0",
    "eslint-config-next": "15.3.7",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
