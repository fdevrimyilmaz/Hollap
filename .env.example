# Database
# Local/default connection string
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/hollap
# Optional deploy-specific URLs (used when DATABASE_URL is not set)
DATABASE_URL_PREVIEW=
DATABASE_URL_PRODUCTION=
# Per-instance Postgres connection pool size. Leave unset to use a runtime-aware
# default (2 on serverless platforms like Netlify/Vercel/Lambda; 5 elsewhere).
# Increase only when running a single long-lived server with predictable load.
DATABASE_POOL_MAX=
# Set true to enable TLS to Postgres. Required for all managed providers
# reachable over the public internet (Supabase, Neon, RDS, etc).
DATABASE_SSL=false
# Optional PEM-encoded CA certificate. When set, the pool uses it as the
# trusted root for TLS verification. Strongly recommended in production.
DATABASE_CA_CERT=
# DANGER: setting this to "false" disables TLS certificate verification,
# permitting MITM on the DB connection. Only use as a temporary opt-out for
# legacy providers; prefer DATABASE_CA_CERT.
DATABASE_SSL_REJECT_UNAUTHORIZED=
# Set true only if you intentionally want runtime migration on first query.
DB_AUTO_MIGRATE=false

# Auth
# Replace these placeholders in every non-local environment.
APP_JWT_SECRET=__REPLACE_WITH_STRONG_SECRET__
REFRESH_TOKEN_SECRET=__REPLACE_WITH_STRONG_SECRET_2__
PASSWORD_RESET_TOKEN_SECRET=__REPLACE_WITH_STRONG_SECRET_3__
EMAIL_VERIFICATION_TOKEN_SECRET=__REPLACE_WITH_STRONG_SECRET_4__
APP_BASE_URL=http://localhost:3000
APP_ALLOWED_ORIGINS=http://localhost:3000
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# OAuth (Google/GitHub)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# File signed URL
FILE_TOKEN_SECRET=__REPLACE_WITH_STRONG_SECRET_5__
FILE_UPLOAD_MAX_FILES=5
FILE_UPLOAD_MAX_BYTES=10485760
FILE_UPLOAD_MAX_TOTAL_BYTES=31457280

# Object storage
OBJECT_STORAGE_DRIVER=local
OBJECT_STORAGE_KEY_PREFIX=private
OBJECT_STORAGE_PRESIGN_TTL_SECONDS=300

# S3 / R2 (required when OBJECT_STORAGE_DRIVER=s3)
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=false

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Live streaming (Mux)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Email notifications (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@creatorhub.local

# Web Push
WEB_PUSH_SUBJECT=mailto:ops@creatorhub.local
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=

# Internal retry endpoint protection
INTERNAL_CRON_KEY=
# Optional key for detailed /api/health metrics
INTERNAL_HEALTH_KEY=
