# Database (required in production/build)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/hollap
DATABASE_POOL_MAX=5
DATABASE_SSL=false

# Auth
APP_JWT_SECRET=change-me
REFRESH_TOKEN_SECRET=change-me-refresh
PASSWORD_RESET_TOKEN_SECRET=change-me-reset
EMAIL_VERIFICATION_TOKEN_SECRET=change-me-email-verify
APP_BASE_URL=http://localhost:3000
APP_ALLOWED_ORIGINS=http://localhost:3000

# File signed URL
FILE_TOKEN_SECRET=change-me-too
FILE_UPLOAD_MAX_FILES=5
FILE_UPLOAD_MAX_BYTES=10485760
FILE_UPLOAD_MAX_TOTAL_BYTES=31457280

# Object storage
OBJECT_STORAGE_DRIVER=local
OBJECT_STORAGE_KEY_PREFIX=private
OBJECT_STORAGE_PRESIGN_TTL_SECONDS=300

# S3 / R2 (required when OBJECT_STORAGE_DRIVER=s3)
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=false

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Live streaming (Mux)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Email notifications (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@creatorhub.local

# Web Push
WEB_PUSH_SUBJECT=mailto:ops@creatorhub.local
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=

# Internal retry endpoint protection
INTERNAL_CRON_KEY=
