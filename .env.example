# =================================================================
# HOLLAP — Production env şablonu (.env.example)
# =================================================================
# Bu dosya repository'ye commit edilir; YALNIZCA placeholder değerler içerir.
# Yerel geliştirme için .env.local oluşturun (gitignore'da).
# Production için Netlify/Vercel UI'sından ekleyin.

# -----------------------------------------------------------------
# Veritabanı (ZORUNLU)
# -----------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/hollap
# Production/preview deploy'lar için ayrı bağlantı stringleri (opsiyonel):
DATABASE_URL_PREVIEW=
DATABASE_URL_PRODUCTION=
# Pool boyutu (otomatik tespit edilirse boş bırak)
DATABASE_POOL_MAX=
# Managed Postgres (Supabase, Neon, RDS) için true yap
DATABASE_SSL=false
DATABASE_CA_CERT=
DATABASE_SSL_REJECT_UNAUTHORIZED=
# Sadece zorunluysa true (production'da migration manuel olmalı)
DB_AUTO_MIGRATE=false

# -----------------------------------------------------------------
# Auth (ZORUNLU) — `npm run env:secrets` ile üretin
# -----------------------------------------------------------------
APP_JWT_SECRET=__REPLACE_WITH_STRONG_SECRET__
REFRESH_TOKEN_SECRET=__REPLACE_WITH_STRONG_SECRET_2__
PASSWORD_RESET_TOKEN_SECRET=__REPLACE_WITH_STRONG_SECRET_3__
EMAIL_VERIFICATION_TOKEN_SECRET=__REPLACE_WITH_STRONG_SECRET_4__
FILE_TOKEN_SECRET=__REPLACE_WITH_STRONG_SECRET_5__
# Bu siteye gelen herkesin gördüğü URL
APP_BASE_URL=https://hollap.example.com
APP_ALLOWED_ORIGINS=https://hollap.example.com
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax

# -----------------------------------------------------------------
# OAuth (opsiyonel) — sosyal giriş için
# -----------------------------------------------------------------
# Google: https://console.cloud.google.com/apis/credentials
#   Redirect URI: ${APP_BASE_URL}/api/auth/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# GitHub: https://github.com/settings/applications/new
#   Callback URL: ${APP_BASE_URL}/api/auth/oauth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# -----------------------------------------------------------------
# Dosya yükleme & object storage
# -----------------------------------------------------------------
FILE_UPLOAD_MAX_FILES=8
FILE_UPLOAD_MAX_BYTES=524288000
FILE_UPLOAD_MAX_TOTAL_BYTES=1073741824

# "local" (dev), "s3" (S3/R2 compatible) — production'da s3 önerilir
OBJECT_STORAGE_DRIVER=local
OBJECT_STORAGE_KEY_PREFIX=private
OBJECT_STORAGE_PRESIGN_TTL_SECONDS=300

# S3 / R2 (OBJECT_STORAGE_DRIVER=s3 ise zorunlu)
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=false

# -----------------------------------------------------------------
# Stripe (ödeme + Stripe Connect)
# -----------------------------------------------------------------
# Test mode: https://dashboard.stripe.com/test/apikeys
# Live: https://dashboard.stripe.com/apikeys
# Connect: https://dashboard.stripe.com/settings/connect
STRIPE_SECRET_KEY=
# Webhook secret: `stripe listen --forward-to your-domain/api/payments/webhook`
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------
# Canlı yayın (Mux)
# -----------------------------------------------------------------
# https://dashboard.mux.com/settings/access-tokens
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# -----------------------------------------------------------------
# E-posta (SMTP) — yapılandırılmazsa dev konsola yazılır
# -----------------------------------------------------------------
# Önerilen ücretsiz: Resend.com, Brevo, Mailtrap.io
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@hollap.example.com

# -----------------------------------------------------------------
# Web Push — `npx web-push generate-vapid-keys`
# -----------------------------------------------------------------
WEB_PUSH_SUBJECT=mailto:ops@hollap.example.com
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=

# -----------------------------------------------------------------
# Dahili güvenlik & cron
# -----------------------------------------------------------------
# /api/internal/* endpoint'lerini koruyan paylaşımlı sır
INTERNAL_CRON_KEY=
# /api/health detaylı metrikler için (opsiyonel)
INTERNAL_HEALTH_KEY=
